{
  "listen": "127.0.0.1:8080",
  "public_url": "https://ci.example.com",
  "root": "/home/you/.local/state/chamber-ci",
  "max_parallel": 1,
  "max_queued": 64,
  "job_timeout": "30m",
  "max_log_bytes": 16777216,
  "repositories": {
    "chamber": {
      "name": "donglin-wang/chamber",
      "token_env": "CHAMBER_GITHUB_TOKEN",
      "secret_env": "CHAMBER_WEBHOOK_SECRET"
    }
  },
  "update": {
    "clone_url": "https://github.com/donglin-wang/chamber.git",
    "ref": "refs/heads/main"
  }
}
