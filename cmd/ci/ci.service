[Unit]
Description=Chamber CI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/chamber-ci -config %h/.config/chamber-ci/config.json
EnvironmentFile=%h/.config/chamber-ci/secrets.env
Restart=on-failure
RestartSec=5
TimeoutStopSec=180
UMask=0077

[Install]
WantedBy=default.target
